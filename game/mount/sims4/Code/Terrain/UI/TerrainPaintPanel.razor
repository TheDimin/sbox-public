@using Sandbox;
@using Sandbox.UI;
@using Sims4.Terrain;
@namespace Sims4.Terrain.UI
@inherits Panel

<root class="terrain-paint-panel">

	<div class="header">
		<label class="title">Terrain Paint</label>
		<div class="toggle" @onclick="@(() => TogglePainting())">
			<label>@(Painter?.PaintingEnabled == true ? "Painting" : "Disabled")</label>
		</div>
	</div>

	<div class="section">
		<label class="section-title">Brush</label>
		<div class="setting">
			<label>Size</label>
			<SliderControl Min="8" Max="512" Step="1" Value="@BrushSize" OnValueChanged="@OnBrushSizeChanged" />
		</div>
		<div class="setting">
			<label>Opacity</label>
			<SliderControl Min="0" Max="1" Step="0.01" Value="@BrushOpacity" OnValueChanged="@OnBrushOpacityChanged" />
		</div>
	</div>

	<div class="section">
		<label class="section-title">Layer</label>
		<div class="layer-toggle">
			<div class="layer-btn @(ActiveLayer == TerrainPaintLayer.Base ? "active" : "")" @onclick="@(() => SetLayer( TerrainPaintLayer.Base ))">
				<label>Base</label>
			</div>
			<div class="layer-btn @(ActiveLayer == TerrainPaintLayer.Overlay ? "active" : "")" @onclick="@(() => SetLayer( TerrainPaintLayer.Overlay ))">
				<label>Overlay</label>
			</div>
		</div>
		<div class="erase-toggle @(IsErasing ? "active" : "")" @onclick="@(() => ToggleErase())">
			<label>Erase</label>
		</div>
	</div>

	<div class="section">
		<label class="section-title">Materials</label>
		<div class="material-grid">
			@foreach ( var mat in Materials )
			{
				<div class="material-tile @(SelectedIndex == mat.MaterialIndex ? "selected" : "")"
					 @onclick="@(() => SelectMaterial( mat.MaterialIndex ))">
					@if ( mat.Thumbnail != null )
					{
						<img src="@mat.Thumbnail" />
					}
					<label>@mat.Name</label>
				</div>
			}
		</div>
	</div>

</root>
