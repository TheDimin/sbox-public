+using NumericsMatrix = System.Numerics.Matrix4x4;
+
+namespace Sandbox;
+
+public sealed partial class SceneCamera
+{
+	private bool TryProjectCustom( Vector3 world, out Vector3 screen )
+	{
+		screen = default;
+		if ( CustomProjectionMatrix is not Matrix projection )
+			return false;
+
+		// The native override and view use column vectors. Matrix.Transform uses rows.
+		var viewPoint = Frustum.GetView().Transpose().Transform( new Vector4( world, 1 ) );
+		var clip = projection.Transpose().Transform( viewPoint );
+		if ( !clip.IsFinite || clip.w == 0 )
+			return false;
+
+		var image = ApplyScreenFlips( new Vector2( .5f + .5f * (clip.x / clip.w), .5f - .5f * (clip.y / clip.w) ), Vector2.One );
+		screen = new Vector3( image.x, image.y, viewPoint.z < 0 && clip.w > 0 ? 1 : -1 );
+		return screen.IsFinite;
+	}
+
+	private bool TryGetInverseCustomProjection( out Matrix inverse, out float nearDepth )
+	{
+		inverse = default;
+		nearDepth = default;
+		if ( CustomProjectionMatrix is not Matrix projection ||
+			!NumericsMatrix.Invert( projection.Transpose(), out var inverseProjection ) )
+			return false;
+
+		inverse = inverseProjection;
+		var zero = inverse.Transform( new Vector4( 0, 0, 0, 1 ) );
+		var one = inverse.Transform( new Vector4( 0, 0, 1, 1 ) );
+		if ( !zero.IsFinite || !one.IsFinite || (zero.w == 0 && one.w == 0) )
+			return false;
+
+		// Native depth spans [0, 1]. Both forward and reverse-Z overrides
+		// are accepted. A homogeneous point at infinity belongs to the far plane.
+		nearDepth = zero.w == 0 || (one.w != 0 && one.z / one.w > zero.z / zero.w) ? 1 : 0;
+		return true;
+	}
+
+	private bool TryUnprojectCustom( Vector2 ndc, out Vector3 nearPoint, out Ray ray )
+	{
+		nearPoint = default;
+		ray = default;
+		if ( !TryGetInverseCustomProjection( out var inverse, out var nearDepth ) )
+			return false;
+
+		var near = inverse.Transform( new Vector4( ndc.x, ndc.y, nearDepth, 1 ) );
+		if ( !near.IsFinite || near.w == 0 )
+			return false;
+
+		// The inverse depth axis is the shared projective eye of the rays.
+		// For orthographic projections it is a direction at infinity.
+		var eye = inverse.Transform( new Vector4( 0, 0, 1, 0 ) );
+		var nearView = new Vector3( near.x, near.y, near.z ) / near.w;
+		var eyeVector = new Vector3( eye.x, eye.y, eye.z );
+		var direction = (eyeVector - nearView * eye.w).Normal;
+		if ( direction.z > 0 )
+			direction = -direction;
+
+		var viewToWorld = Frustum.GetView().Transpose().Inverted;
+		nearPoint = viewToWorld.Transform( nearView );
+		var origin = eye.w == 0 ? nearPoint : viewToWorld.Transform( eyeVector / eye.w );
+		var worldDirection = viewToWorld.Transform( new Vector4( direction, 0 ) );
+		ray = new Ray( origin, new Vector3( worldDirection.x, worldDirection.y, worldDirection.z ) );
+		return nearPoint.IsFinite && origin.IsFinite && ray.Forward.IsFinite && direction != Vector3.Zero;
+	}
+
+	private bool TryGetCustomFrustum( Rect pixelRect, Vector3 size, out Frustum frustum )
+	{
+		frustum = default;
+		if ( size.x <= 0 || size.y <= 0 || !TryGetInverseCustomProjection( out _, out var nearDepth ) )
+			return false;
+
+		NumericsMatrix clip = Frustum.GetView().Transpose() * CustomProjectionMatrix.Value.Transpose();
+		var x = new Vector4( clip.M11, clip.M21, clip.M31, clip.M41 );
+		var y = new Vector4( clip.M12, clip.M22, clip.M32, clip.M42 );
+		var z = new Vector4( clip.M13, clip.M23, clip.M33, clip.M43 );
+		var w = new Vector4( clip.M14, clip.M24, clip.M34, clip.M44 );
+		var bounds = Rect.FromPoints( pixelRect.TopLeft, pixelRect.BottomRight );
+		var left = 2 * bounds.Left / size.x - 1;
+		var right = 2 * bounds.Right / size.x - 1;
+		var top = 1 - 2 * bounds.Top / size.y;
+		var bottom = 1 - 2 * bounds.Bottom / size.y;
+		var lowDepth = ToClipPlane( z );
+		var highDepth = ToClipPlane( w - z );
+		frustum = new Frustum(
+			ToClipPlane( w * right - x ), ToClipPlane( x - w * left ),
+			ToClipPlane( w * top - y ), ToClipPlane( y - w * bottom ),
+			nearDepth == 0 ? lowDepth : highDepth, nearDepth == 0 ? highDepth : lowDepth );
+		return true;
+	}
+
+	private static Plane ToClipPlane( Vector4 clip )
+	{
+		var scale = MathF.Max( MathF.Abs( clip.x ), MathF.Max( MathF.Abs( clip.y ), MathF.Abs( clip.z ) ) );
+		if ( scale == 0 )
+			return new Plane( Vector3.Zero, clip.w > 0 ? float.NegativeInfinity : float.PositiveInfinity );
+
+		clip /= scale;
+		var normal = new Vector3( clip.x, clip.y, clip.z );
+		return new Plane( normal, -clip.w / normal.Length );
+	}
