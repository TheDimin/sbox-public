+  }
+  catch(Exception original){GltfGpuCleanup.Rollback(original,(material is null?Array.Empty<Action>():new Action[]{material.Dispose}).Concat(textures.Select<GltfMaterialLease<Texture>,Action>(t=>t.Dispose)));throw;}
+ }
