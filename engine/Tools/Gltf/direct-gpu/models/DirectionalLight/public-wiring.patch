--- /dev/null
+++ b/engine/Sandbox.Engine/Resources/Model/Model.GltfDirectionalLights.cs
@@ -0,0 +1,32 @@
+using Sandbox.Gltf.DirectGpu.Lighting;
+
+namespace Sandbox;
+
+/// <summary>Authored directional light values, before the native rendering scale.</summary>
+public readonly record struct GltfDirectionalLightInfo( int Node, int Light, Vector3 LinearColor, float IntensityLux );
+
+public partial class Model
+{
+	/// <summary>
+	/// Opt into directional-only native glTF lights. The renderer must also set
+	/// an explicit native light scale. This does not enable point or spot lights
+	/// or claim physical calibration of the engine renderer.
+	/// </summary>
+	public static Model LoadGltf( string filename, int? sceneIndex, bool enableDirectionalLights )
+	{
+		if ( !GltfModelLoader.IsGltfPath( filename ) ) throw new ArgumentException( "Expected a glTF path.", nameof( filename ) );
+		return GltfModelLoader.Load( filename, sceneIndex, enableDirectionalLights );
+	}
+
+	/// <summary>Raw directional light values for this model's selected scene.</summary>
+	public IReadOnlyList<GltfDirectionalLightInfo> GltfDirectionalLights
+	{
+		get
+		{
+			if ( GltfResource is not { DirectionalLightsEnabled: true } resource ) return Array.Empty<GltfDirectionalLightInfo>();
+			var plan = GltfPunctualLightPlan.CreateForScene( resource.Asset.Document, resource.SelectedSceneIndex, allowUnselected: true );
+			return Array.AsReadOnly( plan.Bindings.Select( b => new GltfDirectionalLightInfo( b.Node, b.Light,
+				new Vector3( b.LinearColor.X, b.LinearColor.Y, b.LinearColor.Z ), b.Intensity ) ).ToArray() );
+		}
+	}
+}
