+using System.Numerics;
+using System.Runtime.CompilerServices;
+using System.Threading;
+
+namespace Sandbox.Gltf.DirectGpu.Lighting;
+
+/// <summary>Finite authored point lights for the managed glTF material routes.</summary>
+internal sealed class GltfFinitePointLightBinding : IDisposable
+{
+	private sealed class WorldState
+	{
+		internal readonly int Marker;
+		internal int Owners;
+
+		internal WorldState( int marker ) => Marker = marker;
+	}
+
+	// Keep the private cookie index leased for the graphics session. Its index
+	// cannot be recycled into an ordinary cookie while queued draws retire.
+	private static Texture marker;
+	private static readonly ConditionalWeakTable<SceneWorld, WorldState> worlds = new();
+
+	private readonly WorldState worldState;
+	private readonly GltfPunctualLightInstances instances;
+	private readonly bool[] hidden;
+	private bool enabled;
+	private bool disposed;
+
+	internal static GltfPunctualLightPlan Prepare( GltfDocument document, int? selectedScene )
+	{
+		var root = document.Root;
+		if ( !root.TryGetProperty( "extensionsUsed", out var used ) ||
+			!used.EnumerateArray().Any( item => item.GetString() == GltfPunctualLightPlan.Extension ) ) return null;
+		var required = root.TryGetProperty( "extensionsRequired", out var requirements ) &&
+			requirements.EnumerateArray().Any( item => item.GetString() == GltfPunctualLightPlan.Extension );
+
+		// A required declaration applies to the asset even if this load selects
+		// a different scene. The compiler can preserve portable data that this
+		// runtime does not implement.
+		if ( required )
+		{
+			if ( !root.TryGetProperty( "extensions", out var extensions ) ||
+				!extensions.TryGetProperty( GltfPunctualLightPlan.Extension, out var lightExtension ) ||
+				!lightExtension.TryGetProperty( "lights", out var definitions ) ||
+				definitions.ValueKind != System.Text.Json.JsonValueKind.Array )
+				throw new GltfException( "Required KHR_lights_punctual must declare its light definitions." );
+			for ( int i = 0; i < definitions.GetArrayLength(); i++ )
+			{
+				var light = document.ReadLight( i );
+				if ( Unsupported( light.Type == "point", light.Range ) is { } reason )
+					throw new GltfException( $"Required KHR_lights_punctual contains unsupported {reason}." );
+			}
+		}
+
+		var plan = GltfPunctualLightPlan.CreateForScene( document, selectedScene, allowUnselected: true );
+		if ( plan.UsesUnsupportedOptionalFallback || plan.Bindings.Count == 0 ) return null;
+		var unsupported = plan.Bindings.Select( binding => Unsupported( binding.Kind == GltfPunctualLightPlan.LightKind.Point, binding.RangeMeters ) )
+			.FirstOrDefault( reason => reason is not null );
+		if ( unsupported is null ) return plan;
+		Log.Warning( $"KHR_lights_punctual contains unsupported {unsupported}. The selected scene uses the core no-light fallback." );
+		return null;
+	}
+
+	private static string Unsupported( bool point, float? range )
+	{
+		if ( !point ) return "spot or directional lights";
+		if ( !range.HasValue ) return "unbounded point lights";
+		float radius = (float)(range.Value / .0254);
+		float squaredRadius = radius * radius;
+		return squaredRadius > 0 && float.IsFinite( squaredRadius ) ? null : "point light ranges outside the finite native radius domain";
+	}
+
+	internal static int MarkerIndex( SceneWorld world ) =>
+		worlds.TryGetValue( world, out var state ) && Volatile.Read( ref state.Owners ) > 0 ? state.Marker : -1;
+
+	internal GltfFinitePointLightBinding( GltfPunctualLightPlan plan, SceneWorld world, GltfPose pose, Matrix4x4 placement, IReadOnlyList<bool> visibility )
+	{
+		ThreadSafe.AssertIsMainThread();
+		hidden = new bool[visibility.Count];
+		marker ??= Texture.Create( 1, 1, ImageFormat.RGBA8888 ).WithMips( 1 )
+			.WithData( new byte[] { 255, 255, 255, 255 } ).WithStaticUsage().Finish();
+		if ( !marker.IsValid || marker.Index < 0 ) throw new GltfException( "The private glTF point light marker is unavailable." );
+		worldState = worlds.GetValue( world, _ => new WorldState( marker.Index ) );
+		instances = GltfPunctualLightInstances.Create( plan, new Factory( world ), pose, placement, hidden );
+		Interlocked.Increment( ref worldState.Owners );
+	}
+
+	internal void SetEnabled( bool next, GltfPose pose, Matrix4x4 placement, IReadOnlyList<bool> visibility )
+	{
+		if ( enabled == next ) return;
+		instances.Update( pose, placement, next ? visibility : hidden );
+		enabled = next;
+	}
+
+	internal IReadOnlyList<GltfPunctualLightPlan.State> PrepareUpdate( GltfPose pose, Matrix4x4 placement, IReadOnlyList<bool> visibility ) =>
+		instances.PrepareUpdate( pose, placement, enabled ? visibility : hidden );
+
+	internal void ApplyUpdate( IReadOnlyList<GltfPunctualLightPlan.State> states, IReadOnlyList<bool> visibility ) =>
+		instances.ApplyUpdate( states, enabled ? visibility : hidden );
+
+	internal void Update( GltfPose pose, Matrix4x4 placement, IReadOnlyList<bool> visibility ) =>
+		instances.Update( pose, placement, enabled ? visibility : hidden );
+
+	public void Dispose()
+	{
+		if ( disposed ) return;
+		disposed = true;
+		try { instances.Dispose(); }
+		finally { Interlocked.Decrement( ref worldState.Owners ); }
+	}
+
+	private sealed class Factory( SceneWorld world ) : GltfPunctualLightInstances.IFactory
+	{
+		public GltfPunctualLightInstances.ILight Create( GltfPunctualLightPlan.Binding binding ) => new OwnedPoint( world, binding );
+	}
+
+	private sealed class OwnedPoint : GltfPunctualLightInstances.ILight
+	{
+		private ScenePointLight light;
+		private readonly Color color;
+
+		internal OwnedPoint( SceneWorld world, GltfPunctualLightPlan.Binding binding )
+		{
+			var rgb = binding.LinearColor * binding.Intensity;
+			color = new Color( rgb.X, rgb.Y, rgb.Z );
+			light = new ScenePointLight( world, global::Vector3.Zero, (float)binding.RangeInches.Value, Color.Black );
+			try
+			{
+				light.RenderDiffuse = false;
+				light.RenderSpecular = false;
+				light.RenderTransmissive = false;
+				light.FogLighting = SceneLight.FogLightingMode.None;
+				light.ShadowsEnabled = false;
+				light.LightCookie = marker;
+			}
+			catch { Dispose(); throw; }
+		}
+
+		public void Apply( GltfPunctualLightPlan.State state, bool visible )
+		{
+			var position = state.PositionInches;
+			light.Position = new global::Vector3( position.X, position.Y, position.Z );
+			light.LightColor = visible ? color : Color.Black;
+		}
+
+		public void Dispose()
+		{
+			var owned = light;
+			light = null;
+			owned?.Delete();
+		}
+	}
+}
