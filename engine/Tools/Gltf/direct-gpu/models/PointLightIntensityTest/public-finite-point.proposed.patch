+#ifndef GLTF_FINITE_POINT_LIGHTING_H
+#define GLTF_FINITE_POINT_LIGHTING_H
+
+// No per-draw binding means no marked light. The native no-cookie sentinel
+// cannot match this signed default.
+int g_nGltfFinitePointMarker < Attribute( "GltfFinitePointMarker" ); Default( -1 ); >;
+
+bool GltfAdjustFinitePointLight( inout BinnedLight data, float distanceSq )
+{
+	if ( g_nGltfFinitePointMarker < 0 || data.Type != LightType::LightTypePoint ||
+		!data.HasLightCookie() || data.LightCookieTextureIndex != (uint)g_nGltfFinitePointMarker )
+		return true;
+
+	// A point singularity has no finite receiver irradiance. Keep the stock
+	// BRDF normalization away from zero and reject pixels outside the range.
+	if ( distanceSq <= 0.0 || distanceSq >= data.RadiusSquared )
+		return false;
+
+	const float distanceRatioSq = distanceSq / data.RadiusSquared;
+	const float smoothRange = saturate( 1.0 - distanceRatioSq * distanceRatioSq );
+	const float metersSq = max( distanceSq * (0.0254 * 0.0254), 1e-12 );
+	data.Color *= (1.0 / 3.141592653589793) * smoothRange / metersSq;
+
+	// Change the shader-local copy only. Keep the native clustered list, BRDF,
+	// shadow index and modulator data. Stock material variants never enable this hook.
+	data.Flags &= ~(uint)LightFlags::LightCookieEnabled;
+	data.Flags |= (uint)LightFlags::DiffuseEnabled | (uint)LightFlags::SpecularEnabled | (uint)LightFlags::TransmissiveEnabled;
+	data.LinearFalloff = 0.0;
+	data.QuadraticFalloff = 1.0 / max( distanceSq, 1.0 );
+	data.FalloffBias = 0.0;
+	return true;
+}
