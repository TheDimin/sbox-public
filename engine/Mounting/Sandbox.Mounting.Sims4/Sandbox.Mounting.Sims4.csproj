<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <NoWarn>1701;1702;1591;CA2000</NoWarn>
    <LangVersion>14</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Assembly.cs" />
    <Compile Include="SimsMount.cs" />
    <Compile Include="Resource\ModelLoader.cs" />
    <Compile Include="Resource\TextureLoader.cs" />
    <Compile Include="Resource\MaterialLoader.cs" />
    <Compile Include="Resource\GeomModelBuilder.cs" />
    <Compile Include="Resource\CatalogObjectLoader.cs" />
    <Compile Include="Resource\ModlLoader.cs" />
    <Compile Include="Resource\ModlModelBuilder.cs" />
    <Compile Include="Resource\InlineMaterialLoader.cs" />
    <Compile Include="SimsDebug.cs" />
    <Compile Include="Sims4Reader/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sandbox.Engine\Sandbox.Engine.csproj" />
    <ProjectReference Include="..\..\Sandbox.Filesystem\Sandbox.Filesystem.csproj" />
    <ProjectReference Include="..\..\Sandbox.System\Sandbox.System.csproj" />
    <ProjectReference Include="..\Sandbox.Mounting\Sandbox.Mounting.csproj" />
  </ItemGroup>

  <Target Name="CopyOutputDll" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFiles="..\..\..\game\mount\sims4\sims4.dll" ContinueOnError="true" />
  </Target>

  <!-- Auto-compile mount shaders when source is newer than compiled output -->
  <Target Name="CompileMountShaders" AfterTargets="CopyOutputDll"
          Inputs="..\..\..\game\mount\sims4\Assets\shaders\sims4.shader"
          Outputs="..\..\..\game\mount\sims4\Assets\shaders\sims4.shader_c">
    <Message Importance="high" Text="Compiling sims4 mount shader..." />
    <Exec Command="cd /d &quot;$(MSBuildThisFileDirectory)..\..\..\game&quot; &amp;&amp; bin\managed\ShaderCompiler.exe &quot;mount\sims4\Assets\shaders\sims4.shader&quot; -f -q"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="ShaderCompilerExitCode" />
    </Exec>
    <!-- Fail the build on real shader errors, but ignore exit code 139 (Steam inventory crash) -->
    <Error Condition="'$(ShaderCompilerExitCode)' != '0' AND '$(ShaderCompilerExitCode)' != '139'"
           Text="Shader compilation failed with exit code $(ShaderCompilerExitCode)" />
  </Target>

</Project>
