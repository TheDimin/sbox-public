<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir>$(MSBuildProjectDirectory)/../../../game</GameDir>
    <OutputPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(GameDir)/mounts/gtav</OutputPath>
    <OutputPath Condition="'$(GtaVMountOutputPath)' != ''">$(GtaVMountOutputPath)</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GtaVUseBorealisGeometry)' == 'true'">
    <DefineConstants>$(DefineConstants);GTAV_BOREALIS_GEOMETRY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Ident" Value="gtav" />
    <ProjectReference Include="../../Sandbox.Engine/Sandbox.Engine.csproj" Private="false" />
    <ProjectReference Include="../../Sandbox.Mounting/Sandbox.Mounting.csproj" Private="false" />
    <None Update="ManagedReader/ThirdPartyNotices.txt" TargetPath="licenses/ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="UseHostMountDependencies" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>
</Project>
